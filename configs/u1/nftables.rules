#!/usr/sbin/nft -f

flush ruleset

table inet filter {

    chain input {
        type filter hook input priority 0; policy drop;

        # 4.3.6
        iif "lo" accept
        ip saddr 127.0.0.0/8 counter drop
        ip6 saddr ::1 counter drop

        # 4.3.7
        ip protocol tcp ct state established accept
        ip protocol udp ct state established accept

        ct state established,related accept

        ip saddr 192.168.119.4 tcp dport 22 accept

        ip saddr 192.168.119.4 udp dport 53 accept
        ip saddr 192.168.119.4 tcp dport 53 accept
        ip saddr 192.168.119.68 udp dport 53 accept
        ip saddr 192.168.119.68 tcp dport 53 accept

        ip saddr 192.168.119.0/24 ip protocol icmp accept
    }

    chain forward {
        type filter hook forward priority 0; policy drop;

        ct state established,related accept

        # Routed traffic between subnets
        iif "enp0s8" oif "enp0s8" \
            ip saddr 192.168.119.0/24 \
            ip daddr 192.168.119.0/24 accept

        # Internal network to Internet
        iif "enp0s8" oif "enp0s3" \
            ip saddr 192.168.119.0/24 accept
    }

    chain output {
        type filter hook output priority 0; policy drop;

        oif "lo" accept

        # 4.3.7
        ip protocol tcp ct state established,related,new accept
        ip protocol udp ct state established,related,new accept

        ip protocol icmp accept
    }
}

table ip nat {

    chain postrouting {
        type nat hook postrouting priority srcnat; policy accept;

        oifname "enp0s3" ip saddr 192.168.119.0/24 masquerade
    }
}